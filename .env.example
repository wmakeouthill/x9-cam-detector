# Portas do Sistema (Portas exclusivas para evitar conflitos)
FRONTEND_PORT=39080
BACKEND_PORT=39000

# Configurações da Câmera Intelbras VIP 1230 FC+
CAMERA_IP=192.168.1.108
CAMERA_PORT=554
CAMERA_HTTP_PORT=80
CAMERA_USER=admin
CAMERA_PASSWORD=sua_senha_da_camera_aqui
CAMERA_SUBTYPE=0

# Autenticação da Plataforma (Altere antes de subir em produção)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sua_senha_segura_aqui
JWT_SECRET=gerar_uma_chave_secreta_aleatoria_longa_aqui

# Backup em Nuvem (Google Drive)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=id_da_sua_pasta_no_google_drive
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=service_account.json
